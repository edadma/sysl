module sysl
@tests

// What the root module claims, asserted in sysl.
//
// **Decimal rendering is what this file exists for so far.** `impl[T: Integer] Display for T` renders
// in chunks of up to nineteen digits rather than one digit at a time, which is a real algorithm
// where a peel-one-digit loop was obvious, and the cases below are the ones that tell a correct
// implementation from a plausible one. They agree digit for digit with what the old loop produced;
// that agreement is the whole specification.
//
// What is deliberately **not** here is the speed the change was made for. A timing is not an
// assertion — it is a property of the machine the suite happens to run on — and the numbers are in
// the ticket where they can be reproduced deliberately.

// The narrow widths, where the chunk is smaller than a `u64` and the divisor-computing loop stops
// early: `u8` caps at 100, so a three-digit value takes two chunks and exercises the padding.
@test("an unsigned byte renders across the chunk boundary its own width imposes")
u8_renders()
    assert_eq(str(0), "0")
    assert_eq(str(7), "7")
    assert_eq(str(105), "105")
    assert_eq(str(255), "255")

// **The most negative value of a width is the case a magnitude would get wrong**, its magnitude
// being one larger than the width holds. Nothing here negates, which is what makes it come out.
@test("a signed byte renders, including the value that has no positive twin")
i8_renders()
    assert_eq(str(-128), "-128")
    assert_eq(str(-7), "-7")
    assert_eq(str(0), "0")
    assert_eq(str(127), "127")

@test("the middle widths render")
u16_and_u32_render()
    assert_eq(str(65535), "65535")
    assert_eq(str(1000), "1000")
    assert_eq(str(4294967295u32), "4294967295")
    assert_eq(str(-2147483648), "-2147483648")

// At `u64` the chunk is the whole value, so this is the single-chunk path — and it is the path
// ordinary code takes, so it is the one that must not have regressed.
@test("the whole 64-bit range renders, at both signednesses")
u64_and_i64_render()
    assert_eq(str(18446744073709551615u64), "18446744073709551615")
    assert_eq(str(-9223372036854775808i64), "-9223372036854775808")
    assert_eq(str(9223372036854775807i64), "9223372036854775807")
    assert_eq(str(0), "0")

// **The pair that catches the one real subtlety.** These differ only in a digit that lives inside an
// interior chunk, and a renderer that does not pad such a chunk to its full nineteen digits drops it
// silently — producing a number that is wrong and looks entirely reasonable. The first draft of this
// algorithm got exactly this wrong.
@test("a zero inside an interior chunk survives, which is what the padding is for")
interior_zeros_survive()
    assert_eq(str(10000000000000000000000000u128), "10000000000000000000000000")
    assert_eq(str(10000000000000000000000001u128), "10000000000000000000000001")

    // And a value whose every interior chunk is zero but whose top is not.
    assert_eq(str(100000000000000000000u128), "100000000000000000000")
end interior_zeros_survive

// A width past two chunks, so that "interior" means more than one chunk and the loop is genuinely
// iterating rather than doing a first and a last.
@test("a value spanning three chunks renders")
wide_values_render()
    assert_eq(str(123456789012345678901234567890123456789u128),
              "123456789012345678901234567890123456789")
    assert_eq(str(-170141183460469231731687303715884105728i128),
              "-170141183460469231731687303715884105728")

// Interpolation goes through `display` into a real sink rather than through `str`, so this walks the
// whole path a program actually takes rather than the one the assertions above take.
//
// **Padding is deliberately not asserted here.** `display_digits` does that and is untouched by the
// change; reaching it from a test would need a gathering sink, and `sysl.buf` is built on this module
// and so cannot be reached from it. What chunking could have broken is *which digits come out*, and
// that is what every case in this file asks.
@test("a chunked rendering survives interpolation, which is the path a program takes")
chunked_digits_interpolate()
    assert_eq(s"${105}", "105")
    assert_eq(s"${10000000000000000000000001u128}", "10000000000000000000000001")
    assert_eq(s"n = ${-128}", "n = -128")

// **`Option` and `Result` compare and render**, which are the two blocks that make `assert_eq`
// usable on one -- it is bounded over `Eq + Display`, so either alone would still refuse.
//
// These are the assertions the rest of this file is not: the ones above check a rendering the
// compiler could not have got wrong without getting every number wrong, and these check a rule about
// two values of a shape a program writes constantly. What a wrong `eq` looks like is an `Ok` equal
// to an `Err` carrying the same bytes, or a `None` equal to every other `None` *and* to a `Some` --
// both of which read as working code until something depends on the difference.
@test("an option compares by variant first and then by payload")
options_compare()
    val a: Option[usize] = Some(166)
    val b: Option[usize] = Some(166)
    val c: Option[usize] = Some(167)
    val n: Option[usize] = None

    assert_eq(a, b)
    assert(a != c)

    // The two directions separately: a wrong `eq` that answers by the left operand's variant alone
    // passes one of these and fails the other.
    assert(a != n)
    assert(n != a)
    assert_eq(n, n)

    // The literal on the right, which is what a test actually writes -- and which needs the payload
    // to be read at the parameter's type rather than at its own.
    assert_eq(a, Some(166))
    assert_eq(n, None)
end options_compare

@test("a result compares by variant first and then by payload")
results_compare()
    val ok: Result[usize, string] = Ok(3)
    val same: Result[usize, string] = Ok(3)
    val other: Result[usize, string] = Ok(4)
    val err: Result[usize, string] = Err("nope")

    assert_eq(ok, same)
    assert(ok != other)

    // An `Ok` and an `Err` are never equal, and this is the pair that says so where a comparison
    // reading the payload alone would have called them equal: both carry a 3.
    val three: Result[usize, usize] = Ok(3)
    val failed: Result[usize, usize] = Err(3)

    assert(three != failed)
    assert(failed != three)
    assert(ok != err)
    assert_eq(err, Err("nope"))
end results_compare

// Rendered as it is written, so that a failed comparison names the value a reader typed.
@test("an option and a result render as their source spelling")
options_render()
    val a: Option[usize] = Some(166)
    val n: Option[usize] = None
    val ok: Result[usize, string] = Ok(3)
    val err: Result[usize, string] = Err("nope")

    assert_eq(str(a), "Some(166)")
    assert_eq(str(n), "None")
    assert_eq(str(ok), "Ok(3)")
    assert_eq(str(err), "Err(nope)")

    // Nested, which is the case that says the payload goes through `Display` rather than through
    // anything the renderer knows about integers.
    val nested: Option[Option[usize]] = Some(Some(1))

    assert_eq(str(nested), "Some(Some(1))")
end options_render

// A specifier describes the field the **whole** value occupies (`library/core.md § A specifier is
// the whole value's field`), which is why the rendering is measured before anything is padded
// rather than each part being padded as it goes.
@test("a width pads the whole option rather than its payload")
options_pad()
    val a: Option[usize] = Some(166)
    val n: Option[usize] = None

    assert_eq(f"${a}%12s", "   Some(166)")
    assert_eq(f"${a}%-12s", "Some(166)   ")

    // A width the rendering already exceeds pads by nothing rather than truncating.
    assert_eq(f"${a}%3s", "Some(166)")
    assert_eq(f"${n}%6s", "  None")
end options_pad

// -- a range with both ends written is a value -------------------------------------------------

// The one that decides the shape of `next`. Advancing past the last value and then testing is what
// a reader writes first, and at the top of a width that advance **wraps**: there is no `u8` one
// greater than 255, so the walk would start again at zero and never end.
@test("an inclusive range ending at the width's maximum stops")
inclusive_at_the_maximum_stops()
    // **Bound to a name first, deliberately.** Written straight into the header this is the counted
    // loop and never reaches `Iterate` at all -- which is a different piece of code with the same
    // hazard, pinned by `RangePositionTests` on the compiler's side.
    val top = 250u8..255u8

    var n = 0
    var last: u8 = 0

    for b in top
        n += 1
        last = b

    assert_eq(n, 6)
    assert_eq(last, 255)
end inclusive_at_the_maximum_stops

@test("an empty range yields nothing, whichever way it is empty")
an_empty_range_yields_nothing()
    var n = 0

    for i in 5..<5
        n += 1

    for i in 5..<3
        n += 1

    for i in 5..3
        n += 1

    assert_eq(n, 0)
end an_empty_range_yields_nothing

@test("a range of one value yields it once")
a_range_of_one()
    var seen = 0
    var n = 0

    for i in 7..7
        seen = i
        n += 1

    assert_eq(n, 1)
    assert_eq(seen, 7)
end a_range_of_one

// A range is a value, so it can be named, passed and returned -- which is the whole of what the type
// buys over the form the four positions already read.
@test("a range is named, passed and returned")
a_range_is_a_value()
    val r = 0..<4

    assert_eq(total(r), 6)
    assert_eq(total(upto(3)), 3)

total(r: Range[int]) -> int
    var acc = 0

    for i in r
        acc += i

    acc
end total

upto(n: int) -> Range[int] = 0..<n

// The cursor moves, and a `for` walks a **copy** -- so the same range walked twice answers the same
// values both times. That is `Iterate`'s rule rather than this type's, and it is worth pinning here
// because a range is the first thing anybody will walk twice.
@test("walking a range does not consume the value walked")
walking_leaves_the_range_alone()
    val r = 0..<3

    var first = 0
    var second = 0

    for i in r
        first += i

    for i in r
        second += i

    assert_eq(first, 3)
    assert_eq(second, 3)
end walking_leaves_the_range_alone

// -- the element a cursor yields is the cursor's to choose ---------------------------------------

// `Iterate` names its element with `type Item` rather than taking it as a parameter, and this is
// what that buys: a function generic over what it walks names no element at all. Written
// `count_all[E, I: Iterate[E]]` the same signature was refused, because `E` appeared only in a bound
// and a call has nothing there to solve it from.
@test("a function may be generic over what it walks, naming no element")
generic_over_the_cursor()
    assert_eq(count_all(0..<4), 4)
    assert_eq(count_all("ab".chars), 2)

count_all[I: Iterate](it: I) -> usize
    var n: usize = 0
    var cur = it

    loop
        cur.next() match
            Some(_) -> n += 1
            None -> break

    n
end count_all

// And a body that does want the element names it as a projection, which answers with whatever the
// implementation chose -- an `int` for a range of them, a `char` for a string's characters.
@test("a body that wants the element reads it off the bound")
the_element_is_a_projection()
    assert_eq(first_of(3..<9).unwrap(), 3)
    assert_eq(first_of("hi".chars).unwrap(), 'h')

first_of[I: Iterate](it: I) -> Option[I::Item]
    var cur = it
    cur.next()

// An object fixes the element the implementation would have chosen, which is what makes one
// formable at all: an erased value has forgotten which implementation it came from, so the type it
// yields has to be written down. Both cursors here are the library's own, and neither knows about
// the other.
@test("an erased cursor carries the element in its own type")
an_erased_cursor_says_what_it_yields()
    var r = 0..<4
    var chars = "abc".chars

    assert_eq(drain(&r), 4)
    assert_eq(count_chars(&chars), 3)
end an_erased_cursor_says_what_it_yields

drain(cur: *Iterate[Item = int]) -> usize
    var n: usize = 0

    for _ in cur
        n += 1

    n
end drain

// The same thing written the short way. A trait with no parameters of its own and exactly one
// associated type has only one thing a bare argument could mean, so the two spellings are one type.
count_chars(cur: *Iterate[char]) -> usize
    var n: usize = 0

    for _ in cur
        n += 1

    n
end count_chars

// -- a sequence is equal to one holding the same elements ----------------------------------------
//
// The Scala side asserts these against expectations written in another language, which is where the
// claim about `==` itself belongs -- along with the one about an element type of its own, since an
// `impl` may not sit in a `@tests` file. What is here is what a caller gets from the block: that the
// loop is over the elements rather than over whatever the slice was cut from.

@test("two slices are equal when their elements are")
slices_compare()
    var a: [4]int = [1, 2, 3, 4]
    var b: [4]int = [1, 2, 9, 4]

    assert(a[0..<2] == b[0..<2])
    assert(a[..] != b[..])
    assert(a[3..] == b[3..])

@test("a differing length is enough on its own, whatever the shared prefix holds")
slices_of_unequal_length_differ()
    var a: [4]int = [1, 2, 3, 4]

    assert(a[0..<2] != a[0..<3])
    assert(a[0..<3] != a[0..<2])
    assert(a[2..<2] == a[4..])

@test("an array compares as the elements a slice of it would have walked")
arrays_compare()
    var a: [3]int = [1, 2, 3]
    var b: [3]int = [1, 2, 3]
    var c: [3]int = [1, 9, 3]

    assert(a == b)
    assert(a != c)

// -- and a sequence ORDERS, lexicographically ----------------------------------------------------
//
// First element first, and a shorter sequence before a longer one it is a prefix of. The two are
// separate claims: the first decides between sequences that disagree somewhere, the second between
// sequences that agree everywhere they both reach.

@test("a slice orders by its first differing element")
slices_order()
    var a: [4]int = [1, 2, 3, 4]
    var b: [4]int = [1, 9, 3, 4]

    assert(a[..] < b[..])
    assert(!(b[..] < a[..]))
    assert(!(a[..] < a[..]))

@test("and a prefix orders before what extends it, which is the string rule")
shorter_slice_orders_first()
    var a: [4]int = [1, 2, 3, 4]

    assert(a[0..<2] < a[0..<3])
    assert(!(a[0..<3] < a[0..<2]))
    assert(a[4..] < a[0..<1])

// A negative element is what separates a real comparison from one done on the bytes: `-1 < 1` only
// if the element's own `Ord` is what decides, and a byte-wise order would answer the other way.
@test("the element's own ordering is what decides, not its representation")
slices_order_by_element()
    var a: [2]int = [0 - 1, 5]
    var b: [2]int = [1, 5]

    assert(a[..] < b[..])

@test("an array orders as the slice of it would, at one length")
arrays_order()
    var a: [3]int = [1, 2, 3]
    var b: [3]int = [1, 2, 4]

    assert(a < b)
    assert(!(b < a))
    assert(!(a < a))

// -- and an array HASHES, so a struct over one may derive ----------------------------------------
//
// A hash value is not a promise, so what is asserted is the two properties a table needs: equal
// arrays hash alike, and position matters -- `[1, 2]` and `[2, 1]` are different keys, which a
// mixer folding with XOR alone would get wrong.

@test("equal arrays hash alike")
arrays_hash_alike()
    var a: [3]int = [1, 2, 3]
    var b: [3]int = [1, 2, 3]

    assert_eq(a.hash(), b.hash())

@test("and the order of the elements is part of the key")
array_hash_is_ordered()
    var a: [2]int = [1, 2]
    var b: [2]int = [2, 1]

    assert(a.hash() != b.hash())

// `assert_eq` is what the whole block is for: a bare `bool` says a comparison failed and neither of
// the two sequences that disagreed, which is most of what the assertion is worth.
@test("a sequence is what assert_eq takes now, and it renders on failure")
assert_eq_takes_a_slice()
    var a: [3]int = [1, 2, 3]
    var b: [3]int = [1, 2, 3]

    assert_eq(a, b)
    assert_eq(a[..], b[..])
    assert_eq(a[1..], [2, 3])
    assert_eq(str(a[..]), "[1, 2, 3]")

// A read-only view reaches the same two blocks, which it could not until the shape's members were
// made real at the view the receiver actually had. `[]const u8` is the commonest slice there is --
// it is what `.bytes` answers and what every text routine takes -- so a rendering and an equality it
// could not reach were a rendering and an equality most callers could not use.
@test("a read-only view compares and renders like the writable one")
const_views_compare_and_render()
    var a: [3]int = [1, 2, 3]
    val c: []const int = a[..]
    val d: []const int = a[..]

    assert(c == d)
    assert_eq(c, d)
    assert_eq(str(c), "[1, 2, 3]")
    assert_eq(str("ab".bytes), "[97, 98]")

// The two views meet at the read-only one, so which side of the operator the `[]const T` was written
// on is not something a caller has to think about. It used to be: the pair took the left operand's
// type and re-read the right at it, so one order compiled and its mirror did not.
@test("a comparison between the two views works in either order")
mixed_views_compare()
    var a: [3]int = [1, 2, 3]
    var b: [3]int = [1, 2, 3]
    val c: []const int = b[..]

    assert(c == a[..])
    assert(a[..] == c)
    assert(a[..] == b[..])

// -- the transforming combinators -----------------------------------------------------------------
//
// The forcing ones -- `unwrap`, `unwrap_or`, `expect` -- shipped with the enums. These are the half
// that transforms, and they exist so that `o match Some(v) -> Some(g(v)); None -> None` is written
// once rather than four lines at every call, where one of the four can be got wrong.
//
// Each is asserted on **both** variants, because a combinator that is right about the present case
// and wrong about the absent one is the shape that survives a casual test.

private double_it(n: int) -> int = n * 2
private halve(n: int) -> Option[int] = if n % 2 == 0 then Some(n / 2) else None
private is_even(n: int) -> bool = n % 2 == 0
private zero() -> int = 0
private fallback() -> Option[int] = Some(99)
private grow(n: int) -> Result[int, string] = if n < 100 then Ok(n * 10) else Err("too big")
private recover(e: string) -> Result[int, int] = Ok(int(e.len))
private width(e: string) -> int = int(e.len)

@test("Option.map transforms the payload and carries absence through")
option_map()
    val some: Option[int] = Some(21)
    val none: Option[int] = None

    assert_eq(some.map(double_it), Some(42))
    assert_eq(none.map(double_it), None)

@test("Option.and_then does not nest where map would")
option_and_then()
    val four: Option[int] = Some(4)
    val five: Option[int] = Some(5)
    val none: Option[int] = None

    assert_eq(four.and_then(halve), Some(2))
    assert_eq(five.and_then(halve), None)
    assert_eq(none.and_then(halve), None)

@test("Option.or_else takes the second only where the first has nothing")
option_or_else()
    val some: Option[int] = Some(1)
    val none: Option[int] = None

    assert_eq(some.or_else(fallback), Some(1))
    assert_eq(none.or_else(fallback), Some(99))

@test("Option.filter keeps a payload that passes and drops one that does not")
option_filter()
    val four: Option[int] = Some(4)
    val five: Option[int] = Some(5)
    val none: Option[int] = None

    assert_eq(four.filter(is_even), Some(4))
    assert_eq(five.filter(is_even), None)
    assert_eq(none.filter(is_even), None)

@test("Option.unwrap_or_else computes the default only where it is wanted")
option_unwrap_or_else()
    val some: Option[int] = Some(7)
    val none: Option[int] = None

    assert_eq(some.unwrap_or_else(zero), 7)
    assert_eq(none.unwrap_or_else(zero), 0)

// The crossing that makes a lookup usable in a body that propagates with `?`, which is the whole
// reason the two enums need a way across.
@test("Option.ok_or names the error that absence becomes")
option_ok_or()
    val some: Option[int] = Some(3)
    val none: Option[int] = None

    assert_eq(some.ok_or("missing"), Ok(3))
    assert_eq(none.ok_or("missing"), Err("missing"))

@test("Result.map transforms the success and carries the failure through")
result_map()
    val ok: Result[int, string] = Ok(21)
    val err: Result[int, string] = Err("no")

    assert_eq(ok.map(double_it), Ok(42))
    assert_eq(err.map(double_it), Err("no"))

// How one layer's error type becomes the next one's at a boundary the caller chose.
@test("Result.map_err transforms the failure and carries the success through")
result_map_err()
    val ok: Result[int, string] = Ok(1)
    val err: Result[int, string] = Err("abc")

    assert_eq(ok.map_err(width), Ok(1))
    assert_eq(err.map_err(width), Err(3))

@test("Result.and_then is '?' written as an expression")
result_and_then()
    val small: Result[int, string] = Ok(5)
    val big: Result[int, string] = Ok(500)
    val err: Result[int, string] = Err("no")

    assert_eq(small.and_then(grow), Ok(50))
    assert_eq(big.and_then(grow), Err("too big"))
    assert_eq(err.and_then(grow), Err("no"))

@test("Result.or_else gets the failure in hand to decide by")
result_or_else()
    val ok: Result[int, string] = Ok(1)
    val err: Result[int, string] = Err("abc")

    assert_eq(ok.or_else(recover), Ok(1))
    assert_eq(err.or_else(recover), Ok(3))

@test("Result.ok and Result.err cross to the enum that carries no reason")
result_to_option()
    val ok: Result[int, string] = Ok(4)
    val err: Result[int, string] = Err("no")

    assert_eq(ok.ok(), Some(4))
    assert_eq(ok.err(), None)
    assert_eq(err.ok(), None)
    assert_eq(err.err(), Some("no"))

@test("Result.unwrap_or_else computes the value from the failure")
result_unwrap_or_else()
    val ok: Result[int, string] = Ok(7)
    val err: Result[int, string] = Err("abc")

    assert_eq(ok.unwrap_or_else(width), 7)
    assert_eq(err.unwrap_or_else(width), 3)

// -- the platform constants ------------------------------------------------------------------------
//
// **What is worth asserting here is the AGREEMENT, not the answer.** `os()` returning `MacOS` on a
// Mac says only that a `#if` ladder was written; that the ladder says the same thing the *directive*
// says is the claim the pair exists to keep, and it is the one that would break silently if a symbol
// and a variant ever drifted apart. The compiler-side half of the same equation is derived from the
// registry rather than written down -- see `PlatformRegistryTests`.

@test("the platform a program reads is the platform a directive gates on")
os_agrees_with_the_directive()
#if macos
    assert(os() == MacOS, "'#if macos' holds and 'os()' says otherwise")
#elif linux
    assert(os() == Linux, "'#if linux' holds and 'os()' says otherwise")
#elif windows
    assert(os() == Windows, "'#if windows' holds and 'os()' says otherwise")
#elif android
    assert(os() == Android, "'#if android' holds and 'os()' says otherwise")
#elif wasi
    assert(os() == Wasi, "'#if wasi' holds and 'os()' says otherwise")
#elif freestanding
    assert(os() == Freestanding, "'#if freestanding' holds and 'os()' says otherwise")
#endif
end os_agrees_with_the_directive

@test("the processor a program reads is the processor a directive gates on")
cpu_agrees_with_the_directive()
#if aarch64
    assert(cpu() == Aarch64, "'#if aarch64' holds and 'cpu()' says otherwise")
#elif x86_64
    assert(cpu() == X86_64, "'#if x86_64' holds and 'cpu()' says otherwise")
#elif riscv64
    assert(cpu() == Riscv64, "'#if riscv64' holds and 'cpu()' says otherwise")
#elif riscv32
    assert(cpu() == Riscv32, "'#if riscv32' holds and 'cpu()' says otherwise")
#elif thumb
    assert(cpu() == Thumb, "'#if thumb' holds and 'cpu()' says otherwise")
#elif wasm32
    assert(cpu() == Wasm32, "'#if wasm32' holds and 'cpu()' says otherwise")
#elif x86
    assert(cpu() == X86, "'#if x86' holds and 'cpu()' says otherwise")
#elif craft
    assert(cpu() == Craft, "'#if craft' holds and 'cpu()' says otherwise")
#endif
end cpu_agrees_with_the_directive

// A constant is still a value: it goes in a `val`, crosses a call, and is matched on. That is the
// whole of what this adds over `#if`, so it is what the test exercises.
@test("the platform reaches expression position")
os_is_a_value()
    val here = os()

    assert(here == os(), "the constant does not answer the same thing twice")
    assert(named(here).len > 0, "a platform did not survive being passed to a function")

    val leaf = os() match
        MacOS -> "Library/Caches"
        Windows -> "AppData"
        _ -> ".cache"

    assert(leaf.len > 0, "no arm of a match over the platform was taken")
end os_is_a_value

private named(o: Os) -> string = str(o)

@test("a platform renders as the name it is written with")
os_renders()
    assert_eq(str(MacOS), "MacOS")
    assert_eq(str(Linux), "Linux")
    assert_eq(str(Freestanding), "Freestanding")
    assert_eq(str(Aarch64), "Aarch64")
    assert_eq(str(X86_64), "X86_64")

// What this file can pin: that the call resolves, links and returns without trapping, called once
// and called back to back. Whether it makes a difference to a redirected stream is a claim about
// process-level buffering that no `@test` in the library can observe -- `StdArtifactTests` runs a
// program under a real file descriptor and watches the bytes arrive before it exits.
@test("flush drains the buffered stdout sink without trapping, however often it is called")
flush_is_harmless()
    prints("")
    flush()
    flush()
