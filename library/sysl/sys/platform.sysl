module sysl.sys
@no_alloc

/** What the library asks of the C library it is hosted on for printing, reading, searching and
 * moving bytes. This module is where every declaration in the library that is not sysl lives; the
 * mathematics half of it is in the file beside this one.
 *
 * Each takes a link name, so `putchar`, `snprintf`, `read`, `memchr` and `memmove` stay free for a
 * program to declare itself: a symbol's spelling belongs to whoever exported it, and spending those
 * words out of every program's namespace would buy nothing. An extern's *symbol* is not qualified and
 * cannot be, since it names something the linker already has and the linker knows nothing about
 * sysl's modules — so these are keyed under `sysl.sys` like every other name here while going on
 * resolving to `putchar`, `snprintf` and the rest.
 *
 * They are `private[sysl]` because a program has no business calling them and no reason to want to:
 * what they are for is the printing, the reading and the argument conversion the library offers, and
 * each of those is a better thing to call than the C function under it. That is also what the module
 * is for. A name here is one the rest of the library may reach and nothing else may, so putting one
 * in `sys` is a decision about the library's own workings rather than an addition to its surface.
 */
private[sysl] extern "putchar" sysl_putchar(c: int) -> int
private[sysl] extern "snprintf" sysl_snprintf(buf: *u8, n: usize, fmt: *u8, ...) -> int
private[sysl] extern "read" sysl_read(fd: int, p: *u8, n: usize) -> isize
private[sysl] extern "write" sysl_write(fd: int, p: *u8, n: usize) -> isize
private[sysl] extern "memchr" sysl_memchr(p: *u8, c: int, n: usize) -> *u8
private[sysl] extern "memmove" sysl_memmove(dst: *u8, src: *u8, n: usize) -> *u8
private[sysl] extern "strtod" sysl_strtod(p: *u8, end: **u8) -> real

// `NULL` flushes every open output stream rather than naming one, which is what `sysl.flush` wants:
// naming `stdout` itself would need an `extern` variable, and `stdout` is a `#define` on Darwin that
// no `extern` reaches.
private[sysl] extern "fflush" sysl_fflush(stream: *u8) -> int
